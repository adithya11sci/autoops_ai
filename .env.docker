# ============================================================
# AutoOps AI — Docker deployment env overrides
# Used when running the app via docker-compose (autoops-app service).
# These override the matching keys in .env.
# For local npm run dev, edit .env directly.
# ============================================================

POSTGRES_HOST=postgres
KAFKA_BROKERS=kafka:9092
CHROMA_HOST=chromadb
REDIS_HOST=redis
HOST=0.0.0.0
PORT=3000
NODE_ENV=production
